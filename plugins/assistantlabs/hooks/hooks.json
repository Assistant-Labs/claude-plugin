{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.cjs\"",
						"timeout": 5
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "mcp__.*[Aa]ssistant_?[Ll]abs.*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-outbound.cjs\"",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "mcp__.*[Aa]ssistant_?[Ll]abs.*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/audit-log.cjs\"",
						"timeout": 5
					}
				]
			}
		]
	}
}
